{
  "name": "discord-html-transcript-discordjs",
  "version": "0.1.0-beta.2",
  "description": "Generate natively styled Discord chat logs with discord.js",
  "keywords": [
    "discord",
    "discordjs",
    "discord-logs",
    "discord-tickets",
    "discord-transcripts"
  ],
  "homepage": "https://github.com/omardiaadev/discord-html-transcript-discordjs",
  "bugs": {
    "url": "https://github.com/omardiaadev/discord-html-transcript-discordjs/issues"
  },
  "license": "Apache-2.0",
  "author": "Omar Diaa <contact@omardiaa.dev> (https://github.com/omardiaadev)",
  "funding": "https://github.com/sponsors/omardiaadev",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omardiaadev/discord-html-transcript-discordjs.git"
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --env-file=.env --import tsx --test src/service/transcriber-client.test.ts"
  },
  "dependencies": {
    "env-paths": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.2",
    "eslint": "^10.2.0",
    "prettier": "3.8.1",
    "prettier-plugin-jsdoc": "^1.8.0",
    "tsdown": "^0.21.7",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1"
  },
  "peerDependencies": {
    "discord.js": "^14.0.0"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "packageManager": "pnpm@10.33.0",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "server": {
    "version": "0.1.0-beta.5"
  }
}
