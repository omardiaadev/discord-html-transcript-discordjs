{
  "name": "discord-html-transcript-discordjs",
  "version": "0.1.0-beta.1",
  "description": "Generate natively styled logs for Discord chats with discord.js",
  "keywords": [
    "discord",
    "discordjs",
    "discord-transcripts"
  ],
  "homepage": "https://github.com/omardiaadev/discord-html-transcript-discordjs",
  "bugs": {
    "url": "https://github.com/omardiaadev/discord-html-transcript-discordjs/issues"
  },
  "license": "Apache-2.0",
  "author": "Omar Diaa <contact@omardiaa.dev> (https://github.com/omardiaadev)",
  "funding": "https://github.com/omardiaadev/discord-html-transcript-discordjs?sponsor",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omardiaadev/discord-html-transcript-discordjs.git"
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --env-file=.env --experimental-vm-modules node_modules/jest/bin/jest.js",
    "postinstall": "node dist/scripts/download-server.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "eslint": "^10.1.0",
    "jest": "^30.3.0",
    "prettier": "3.8.1",
    "prettier-plugin-jsdoc": "^1.8.0",
    "ts-jest": "^29.4.6",
    "tsdown": "^0.21.4",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2"
  },
  "peerDependencies": {
    "discord.js": "^14.0.0"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "packageManager": "pnpm@10.32.1",
  "server": {
    "version": "0.1.0-beta.4"
  }
}
