{
  "name": "discord-html-transcript-discordjs",
  "version": "0.1.0-beta.3",
  "description": "Generate natively styled HTML chat logs with your discord.js bot",
  "keywords": [
    "html",
    "markdown",
    "transcript",
    "archive",
    "export",
    "backup",
    "ticket-system",
    "discord",
    "discordjs",
    "discord-bot",
    "discord-logs",
    "discord-library",
    "discord-html-transcripts"
  ],
  "homepage": "https://github.com/omardiaadev/discord-html-transcript-discordjs",
  "bugs": {
    "url": "https://github.com/omardiaadev/discord-html-transcript-discordjs/issues"
  },
  "license": "Apache-2.0",
  "author": "Omar Diaa <contact@omardiaa.dev> (https://github.com/omardiaadev)",
  "funding": "https://github.com/sponsors/omardiaadev",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omardiaadev/discord-html-transcript-discordjs.git"
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --import tsx --test src/service/transcriber-client.test.ts"
  },
  "dependencies": {
    "env-paths": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "eslint": "^10.5.0",
    "prettier": "3.8.4",
    "prettier-plugin-jsdoc": "^1.8.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "peerDependencies": {
    "discord.js": "^14.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^11",
      "onFail": "warn"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "server": {
    "version": "0.1.0-beta.7"
  }
}
